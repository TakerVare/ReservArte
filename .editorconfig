# =============================================================================
# ReservArte · Convenciones de formato del repositorio
# =============================================================================
# Fija por escrito el estilo que YA tiene el código, para que editores,
# `dotnet format` y Prettier digan lo mismo y nadie lo cambie sin querer.
#
# Regla de oro: este fichero NO puede introducir avisos. La línea base de
# `dotnet format --verify-no-changes` es CERO desde RA-869f2pjf8 (PR #72), y así
# debe seguir. Al tocarlo, comprobarlo:
#     dotnet format --verify-no-changes; echo "EXIT=$?"
# Sin encadenar con `| tail`: se leería el código de salida de `tail`.
#
# NO se fija `end_of_line` para el código: el repositorio se trabaja en macOS y
# en Windows con `core.autocrlf=true`, así que el índice guarda LF y el árbol de
# trabajo de Windows tiene CRLF. Fijarlo aquí haría fallar el formateo en uno de
# los dos equipos. De los finales de línea se encarga git, no el editor.
# =============================================================================

root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# En Markdown, dos espacios al final de línea SON un salto de línea.
[*.md]
trim_trailing_whitespace = false

# Los scripts de shell (data/schema/regenerate-create.sh) se ejecutan desde Git
# Bash: con CRLF, bash puede fallar con `$'\r': command not found`.
[*.sh]
end_of_line = lf

[*.sql]
indent_size = 4

# Frontend: coincide con reservarte-web/.prettierrc (tabWidth 2, printWidth 100).
# Prettier 3 lee este fichero, pero su propia configuración manda sobre él; se
# mantienen alineados a propósito para que no discrepen.
[*.{ts,js,mjs,cjs,vue,json,jsonc,css,scss,html,yml,yaml}]
indent_size = 2
max_line_length = 100

# =============================================================================
# C#
# =============================================================================
[*.cs]
indent_size = 4

# ── Organización del fichero ─────────────────────────────────────────────────
# `using` fuera del namespace y System primero, como está hoy todo el código.
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Namespace de ámbito de fichero: `namespace ReservArte.Domain.Entities;`
csharp_style_namespace_declarations = file_scoped:suggestion

# ── Llaves y saltos de línea (estilo Allman, el del proyecto) ────────────────
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# ── Sangrado ─────────────────────────────────────────────────────────────────
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_indent_block_contents = true
csharp_indent_braces = false

# ── Espaciado ────────────────────────────────────────────────────────────────
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_parentheses = false

# ── Preferencias de lenguaje ─────────────────────────────────────────────────
# `var` cuando el tipo se ve en la propia línea; tipo explícito cuando no.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Miembros con cuerpo de expresión: se usan en el proyecto para lo corto
# (`public void Dispose() => _connection.Dispose();`).
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion

csharp_style_prefer_switch_expression = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_prefer_braces = true:suggestion

dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_auto_properties = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# ── Nombres ──────────────────────────────────────────────────────────────────
# Severidad `suggestion` a propósito: el objetivo es dejar la convención escrita
# sin convertir `dotnet format` en un comando que falle por nombres.

dotnet_naming_rule.private_fields_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore_camel_case.severity = suggestion

dotnet_naming_rule.types_pascal_case.symbols = types_and_members
dotnet_naming_rule.types_pascal_case.style = pascal_case
dotnet_naming_rule.types_pascal_case.severity = suggestion

dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = begins_with_i
dotnet_naming_rule.interfaces_start_with_i.severity = suggestion

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =

dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, enum, property, method, event
dotnet_naming_symbols.types_and_members.applicable_accessibilities = *

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.begins_with_i.capitalization = pascal_case
dotnet_naming_style.begins_with_i.required_prefix = I

# =============================================================================
# Ficheros generados: no se editan a mano y no deben formatearse.
# Las migraciones y el snapshot los escribe `dotnet ef`; el `create` lo genera
# data/schema/regenerate-create.sh.
# =============================================================================
[ReservArte-Infrastructure/Persistence/Migrations/*.cs]
generated_code = true

[data/schema/create_ReservArteDB.sql]
trim_trailing_whitespace = false
insert_final_newline = false
