{
  "MultiTenant": {
    "ResolutionStrategy": "Header",
    "HeaderName": "X-Organization-Id",
    "DefaultOrganizationId": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Redsys": {
    "DefaultEnvironment": "test",
    "SecretsProvider": "UserSecrets"
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}