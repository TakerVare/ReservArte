{
  "MultiTenant": {
    "ResolutionStrategy": "Subdomain",
    "BaseDomain": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Aws": {
    "Ses": {
      "Region": "eu-west-1",
      "FromName": "ReservArte"
    }
  },
  "Redsys": {
    "DefaultEnvironment": "production",
    "SecretsProvider": "SecretsManager",
    "WebhookBaseUrl": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "AWS.Logger.SeriLog" ],
    "LogGroup": "/reservarte/api",
    "Region": "eu-west-1",
    "WriteTo": {
      "CloudWatchSink": {
        "Name": "AWSSeriLog"
      }
    }
  }
}