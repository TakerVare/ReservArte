<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Hangfire.Core" Version="1.8.25" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <!-- Proveedor de PostgreSQL (licencia PostgreSQL). D-28, RA-869f8pmpa. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Familia Microsoft.IdentityModel: una sola versión, la que exige JwtBearer 10.0.x (8.19.2).
         Protocols.OpenIdConnect ya no se fija aquí: solo hacía falta por Microsoft.Data.SqlClient,
         que se fue con SQL Server (RA-869f8pmpa). -->
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.19.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ReservArte-Domain\ReservArte.Domain.csproj" />
    <ProjectReference Include="..\ReservArte-Application\ReservArte.Application.csproj" />
  </ItemGroup>
</Project>